# Cấu hình Firebase cho Streak Logger.
# Lấy giá trị tại: Firebase Console > Project settings > Your apps > Web app (Config).
# Sau khi điền xong, chạy lại "npm run dev" để áp dụng.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
